-    public static OfferDto ToDto(this Offer offer) => new(
-        offer.Id,
-        offer.Amount,
-        offer.TermMonths,
-        offer.InterestRate,
-        offer.MonthlyPayment,
-        offer.ExpiresAt,
-        offer.Response,
-        offer.RespondedAt);
+    public static OfferDto ToDto(this Offer offer, ProductType productType = ProductType.WorkingCapital)
+    {
+        decimal? totalPayment = productType is ProductType.WorkingCapital or ProductType.Express or ProductType.Investment
+            ? LoanMath.Schedule(offer.Amount, offer.InterestRate, offer.TermMonths,
+                DateOnly.FromDateTime(offer.CreatedAt.UtcDateTime).AddMonths(1)).Sum(row => row.Payment)
+            : null;
+        return new(
+            offer.Id,
+            offer.Amount,
+            offer.TermMonths,
+            offer.InterestRate,
+            offer.MonthlyPayment,
+            totalPayment,
+            totalPayment - offer.Amount,
+            offer.ExpiresAt,
+            offer.Response,
+            offer.RespondedAt);
+    }
 
     public static ScoringDto ToDto(this ScoringResult scoring) => new(
         scoring.Score,
diff --git a/tests/AlfaCredit.IntegrationTests/Endpoints/OfferMappingTests.cs b/tests/AlfaCredit.IntegrationTests/Endpoints/OfferMappingTests.cs
new file mode 100644
index 0000000..55770f6
--- /dev/null
+++ b/tests/AlfaCredit.IntegrationTests/Endpoints/OfferMappingTests.cs
@@ -0,0 +1,32 @@
+using System.Text.Json;
+using AlfaCredit.Api.Mapping;
+using AlfaCredit.Core.Domain.Decisions;
+using Shouldly;
+
+namespace AlfaCredit.IntegrationTests.Endpoints;
+
+public sealed class OfferMappingTests
+{
+    [Fact]
+    public void Limit_product_does_not_expose_an_annuity_total()
+    {
+        var offer = Offer.Create(Guid.NewGuid(), Guid.NewGuid(), 1_500_000m, 12, 19.5m, 138_593.06m,
+            DateTimeOffset.UtcNow, TimeSpan.FromDays(7));
+        foreach (var type in new[] { AlfaCredit.Core.Domain.Products.ProductType.Overdraft, AlfaCredit.Core.Domain.Products.ProductType.CreditLine })
+        {
+            var json = JsonSerializer.SerializeToElement(offer.ToDto(type), new JsonSerializerOptions(JsonSerializerDefaults.Web));
+            json.GetProperty("totalPayment").ValueKind.ShouldBe(JsonValueKind.Null);
+            json.GetProperty("totalInterest").ValueKind.ShouldBe(JsonValueKind.Null);
+        }
+    }
+    [Fact]
+    public void Offer_exposes_schedule_totals_before_acceptance_including_last_payment_rounding()
+    {
+        var offer = Offer.Create(Guid.NewGuid(), Guid.NewGuid(), 1_500_000m, 12, 19.5m, 138_593.06m,
+            DateTimeOffset.UtcNow, TimeSpan.FromDays(7));
+        var json = JsonSerializer.SerializeToElement(offer.ToDto(), new JsonSerializerOptions(JsonSerializerDefaults.Web));
+        json.GetProperty("totalPayment").GetDecimal().ShouldBe(1_663_116.74m);
+        json.GetProperty("totalInterest").GetDecimal().ShouldBe(163_116.74m);
+        json.GetProperty("response").GetInt32().ShouldBe((int)OfferResponse.Pending);
+    }
+}
